</tr>
<tr>
<td>Month_Short</td>
<td>Month (con array('gregorian', 'format', 'abbreviated')</td>
</tr>
<tr>
<td>Month_Narrow</td>
<td>Month (con array('gregorian', 'stand-alone', 'narrow')</td>
</tr>
<tr>
<td>Month_Complete</td>
<td>Months</td>
</tr>
<tr>
<td>Day_Short</td>
<td>Day (con array('gregorian', 'format', 'abbreviated')</td>
</tr>
<tr>
<td>Day_Narrow</td>
<td>Day (con array('gregorian', 'stand-alone', 'narrow')</td>
</tr>
<tr>
