<?php
/* Shared page header + left site-nav for the TigerZF manual.
   Every page does: <?php $title = '...'; include __DIR__ . '/_header.phtml'; ?>
   LANGUAGE-AGNOSTIC: all visible text comes from _i18n.php ($T), so this file is
   byte-identical in every /docs/<lang>/ directory — only _i18n.php differs.
   Edit here to change the header / nav on ALL pages, in ALL languages. */
require __DIR__ . '/_i18n.php';                    // -> $LANG, $LANGS, $T
if (!isset($title)) { $title = $T['manual']; }
/* current page filename, for the language switcher's same-page links.
   A fallback renderer (e.g. es/_fallback.php) may pre-set $__file to the real page. */
if (!isset($__file)) {
    $__file = basename($_SERVER['SCRIPT_NAME'] ?? '');
    if ($__file === '' || substr($__file, -6) !== '.phtml') { $__file = 'index.phtml'; }
}
?><!doctype html>
<html lang="<?= htmlspecialchars($LANG) ?>" class="tzf-docs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><?= htmlspecialchars($title) ?> &mdash; TigerZF</title>
<link rel="stylesheet" type="text/css" href="dbstyle.css">
<link rel="stylesheet" type="text/css" href="docs.css">
<script>window.TZF_I18N = <?= json_encode($T, JSON_UNESCAPED_UNICODE | JSON_HEX_TAG) ?>;</script>
</head>
<body>
<header class="tzf-header">
  <button class="tzf-menu-btn" aria-label="<?= htmlspecialchars($T['toggle_nav']) ?>">&#9776;</button>
  <a class="tzf-brand" href="index.phtml">Tiger<b>ZF</b></a>
  <span class="spacer"></span>
  <div class="tzf-search">
    <span class="icn">&#9906;</span>
    <input type="search" placeholder="<?= htmlspecialchars($T['search_ph']) ?>" aria-label="<?= htmlspecialchars($T['search_aria']) ?>" autocomplete="off">
    <span class="kbd">/</span>
  </div>
<?php if (count($LANGS) > 1): ?>
  <details class="tzf-langpick">
    <summary aria-label="<?= htmlspecialchars($T['language']) ?>"><span class="tzf-globe">&#127760;</span><span class="tzf-lang-cur"><?= htmlspecialchars($LANGS[$LANG] ?? strtoupper($LANG)) ?></span><span class="tzf-caret">&#9662;</span></summary>
    <ul>
<?php foreach ($LANGS as $code => $name): ?>
<?php if ($code === $LANG): ?>
      <li><span class="cur" aria-current="true"><?= htmlspecialchars($name) ?></span></li>
<?php else:
        $href = is_file(__DIR__ . '/../' . $code . '/' . $__file) ? '../' . $code . '/' . $__file : '../' . $code . '/'; ?>
      <li><a href="<?= htmlspecialchars($href) ?>"><?= htmlspecialchars($name) ?></a></li>
<?php endif; ?>
<?php endforeach; ?>
    </ul>
  </details>
<?php endif; ?>
</header>
<div class="tzf-layout">
  <aside class="tzf-sidenav">
    <div class="tzf-filter"><input type="search" placeholder="<?= htmlspecialchars($T['filter_ph']) ?>" aria-label="<?= htmlspecialchars($T['filter_aria']) ?>" autocomplete="off"></div>
    <div class="tzf-nav-scroll"><?php include __DIR__ . '/_nav.html'; ?></div>
  </aside>
  <main class="tzf-content"><div class="content-inner">
