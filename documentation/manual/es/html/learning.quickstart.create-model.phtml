    'default',
    true) ?&gt;"&gt;Sign Our Guestbook&lt;/a&gt;&lt;/p&gt;

Guestbook Entries: &lt;br /&gt;
&lt;dl&gt;
    &lt;?php foreach ($this-&gt;entries as $entry): ?&gt;
    &lt;dt&gt;&lt;?php echo $this-&gt;escape($entry-&gt;email) ?&gt;&lt;/dt&gt;
