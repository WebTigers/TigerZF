  &lt;/url&gt;
&lt;/urlset&gt;
</pre>
<p>
                Renderice el sitemap usando una profundidad máxima de 1.
            </p>
<pre class="programlisting">
echo $this-&gt;navigation()
          -&gt;sitemap()
          -&gt;setFormatOutput(true)
          -&gt;setMaxDepth(1);
</pre>
<pre class="programlisting">
