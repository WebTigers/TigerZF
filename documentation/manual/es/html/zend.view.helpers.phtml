                        'action'     =&gt; 'archive'
                    )
                )
            )
        )
    ),
    array(
        'label'      =&gt; 'Community',
        'module'     =&gt; 'community',
        'controller' =&gt; 'index',
        'action'     =&gt; 'index',
        'pages'      =&gt; array(
