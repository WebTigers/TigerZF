                        </td>
</tr>
<tr>
<td><code class="methodname">getClassAutoloaders($class)</code></td>
<td><span class="type">Array</span></td>
<td>
                            <div class="itemizedlist"><ul class="itemizedlist" style="list-style-type: disc; "><li class="listitem"><p>
